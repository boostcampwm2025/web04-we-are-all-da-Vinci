# ==================== 서버 기본 ====================

PORT=3000
# production이 아니면 부팅 시 마이그레이션 자동 실행 + MikroORM debug 로그 활성화
NODE_ENV=development
# pino 로그 레벨
LOG_LEVEL=debug
# 허용 오리진 (쉼표 구분) — client-toss dev 서버 기본 포트가 5173
CORS_ORIGIN=http://localhost:5173

# ==================== MySQL ====================
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_DATABASE=daVinci_toss

# ==================== 인증/보안 ====================
# JWT 서명 키 — 32자 이상 필수
JWT_SECRET=32자 이상 문자열
# 토스 로그아웃 콜백 엔드포인트 Basic Auth 자격증명
TOSS_CALLBACK_BASIC_AUTH_USERNAME=username
TOSS_CALLBACK_BASIC_AUTH_PASSWORD=password

# ==================== Toss API 연동 ====================
# 외부 연동 모드 스위치: mock(기본, 목 서버) | flaky(포인트 지급 랜덤 실패 시뮬레이션) | toss(실제 토스 API)
# toss가 아니면 아래 TOSS_API_*/TOSS_DECRYPT_*/TOSS_CLIENT_* 값은 안 쓰임
EXTERNAL_API=mock
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_API_KEY=TossApiKey
# 토스가 보내는 페이로드 복호화 키 (AES-GCM)
TOSS_DECRYPT_KEY=TossDecryptKey
# 복호화 시 사용하는 AAD(Additional Authenticated Data) 값
TOSS_DECRYPT_AAD=TOSS
# 토스 API 호출용 클라이언트 인증서 (mTLS)
TOSS_CLIENT_CERT_PATH=./certs/davinci_new_public.crt
TOSS_CLIENT_KEY_PATH=./certs/davinci_new_private.key

# ==================== 기회(chance) — 공유/광고 적립 ====================
# 공유 적립 일일 캡 (기본 3) — KST 자정 리셋, contactsViral + share 폴백 합산. 광고는 캡 없음
SHARE_DAILY_CHARGE_LIMIT=3
# 콘솔에 등록한 광고 그룹 ID 화이트리스트 (쉼표 구분) — 필수, 비어있으면 부팅 실패
AD_GROUP_ID_WHITELIST=
# 공유 리워드 모듈 ID 화이트리스트 (쉼표 구분) — 필수, 비어있으면 부팅 실패
SHARE_MODULE_ID_WHITELIST=
# 초대(공유) 적립 일일 한도 (기본 5)
INVITE_DAILY_LIMIT=5

# ==================== 출석(attendance) ====================
# 출석 연속 복구용 보상형 광고 그룹 ID — 필수, 없으면 부팅 실패
ATTENDANCE_AD_GROUP_ID=

# ==================== 알림(notification) ====================
# 알림 발송 상태가 IN_FLIGHT로 이 시간(분) 이상 멈춰있으면 정리 스케줄러가 청소 (기본 60)
NOTIFICATION_STALE_THRESHOLD_MINUTES=60

# 일일 프롬프트 알림 발송 스케줄러 on/off — true면 아래 템플릿 ID 필수
DAILY_PROMPT_NOTIFICATION_ENABLED=false
TOSS_TEMPLATE_DAILY_PROMPT=

# 랭킹 추월(RANKING_CHANGED 이벤트) 알림 발송 on/off — true면 아래 템플릿 ID 필수
OVERTAKEN_NOTIFICATION_ENABLED=false
TOSS_TEMPLATE_OVERTAKEN=

# 연속 출석 마일스톤 알림 발송 on/off — true면 아래 템플릿 ID 필수
ATTENDANCE_STREAK_NOTIFICATION_ENABLED=false
TOSS_TEMPLATE_ATTENDANCE_STREAK=

# ==================== 포인트 지급 코드 ====================
PROMOTION_CODE=TEMP_PROMOTION_CODE